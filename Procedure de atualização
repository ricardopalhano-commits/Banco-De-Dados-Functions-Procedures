CREATE TABLE IF NOT EXISTS alunos (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    idade INT NOT NULL,
    nota DECIMAL(5,2) NOT NULL DEFAULT 0
);

DROP PROCEDURE IF EXISTS aumentar_nota;

DELIMITER $$

CREATE PROCEDURE aumentar_nota(
    IN p_id_aluno INT,
    IN p_aumento DECIMAL(5,2)
)
BEGIN
    UPDATE alunos
    SET nota = nota + p_aumento
    WHERE id = p_id_aluno;
END$$

DELIMITER ;

INSERT INTO alunos (id, nome, idade, nota)
VALUES (5, 'Aluno Teste', 20, 7.00)
ON DUPLICATE KEY UPDATE id = id;

CALL aumentar_nota(5, 1);

SELECT *
FROM alunos
WHERE id = 5;
